{
  "name": "dev.to",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/reinaldocoelho/dev.to.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "new": "dev new",
    "push": "dev push \"blog-posts/**/article.md\"",
    "push:dry": "dev push \"blog-posts/**/article.md\" --dry-run --verbose",
    "reconcile:dry": "dev push \"blog-posts/**/article.md\" --reconcile --dry-run --verbose",
    "stats": "dev stats",
    "embedme:check": "embedme --verify \"blog-posts/**/*.md\"",
    "embedme:write": "embedme \"blog-posts/**/*.md\"",
    "prettier:check": "prettier --check \"**/*.{js,json,md,ts,yml}\"",
    "prettier:write": "prettier --write \"**/*.{js,json,md,ts,yml}\"",
    "check": "npm run embedme:check && npm run prettier:check",
    "format": "npm run embedme:write && npm run prettier:write",
    "check-updates": "npx npm-check-updates"
  },
  "devDependencies": {
    "@sinedied/devto-cli": "^1.4.0",
    "embedme": "^1.22.1",
    "prettier": "^3.9.10"
  }
}
